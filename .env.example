# Copia questo file in .env.local e inserisci i valori del progetto Supabase OutingModules.
# Le variabili con prefisso VITE_ finiscono nel bundle e sono pubbliche: qui vanno solo
# l'URL e la chiave pubblica (publishable key, sb_publishable_...).
# NON inserire mai la secret key / service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo per i test sul database (utente di prova). Il valore resta in .env.local.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
